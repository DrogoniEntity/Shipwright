{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Init Project",
            "group": "build",
            "type": "shell",
            "command": "/bin/bash",
            "args": [ "builder/actions/init.sh" ],
        },
        {
            "label": "Build Project",
            "group": "build",
            "type": "shell",
            "command": "/bin/bash",
            "args": [ "builder/actions/build.sh" ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Init Nintendo Switch",
            "group": "build",
            "type": "shell",
            "command": "/bin/bash",
            "args": [ "builder/actions/init-switch.sh" ]
        },
        {
            "label": "Build Nintendo Switch",
            "group": "build",
            "type": "shell",
            "command": "/bin/bash",
            "args": [ "builder/actions/build-switch.sh" ],
            "problemMatcher": "$gcc"
        }
    ]
}